{
  "name": "nobodyclimb",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "strip-ansi": "^6.0.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nobodyclimb/web dev",
    "dev:mobile": "pnpm --filter @nobodyclimb/mobile start",
    "dev:backend": "pnpm --filter @nobodyclimb/api dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@nobodyclimb/web",
    "build:cf": "turbo run build:cf --filter=@nobodyclimb/web",
    "lint": "biome check .",
    "test": "turbo run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.3.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --fix --no-errors-on-unmatched"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
